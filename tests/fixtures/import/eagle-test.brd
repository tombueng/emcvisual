<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE eagle SYSTEM "eagle.dtd">
<!-- Hand-written test board for the Eagle importer (tests/import.test.ts). 0BSD like the project. -->
<eagle version="9.6.2">
<drawing>
<settings><setting alwaysvectorfont="no"/></settings>
<grid distance="0.1" unitdist="mm" unit="mm"/>
<layers>
<layer number="1" name="Top" color="4" fill="1" visible="yes" active="yes"/>
<layer number="2" name="$GND" color="1" fill="1" visible="yes" active="yes"/>
<layer number="15" name="Route15" color="1" fill="1" visible="yes" active="yes"/>
<layer number="16" name="Bottom" color="1" fill="1" visible="yes" active="yes"/>
<layer number="20" name="Dimension" color="15" fill="1" visible="yes" active="yes"/>
<layer number="41" name="tRestrict" color="4" fill="10" visible="yes" active="yes"/>
<layer number="42" name="bRestrict" color="1" fill="10" visible="yes" active="yes"/>
</layers>
<board>
<plain>
<wire x1="0" y1="0" x2="40" y2="0" width="0" layer="20"/>
<wire x1="40" y1="0" x2="40" y2="30" width="0" layer="20"/>
<wire x1="40" y1="30" x2="0" y2="30" width="0" layer="20"/>
<wire x1="0" y1="30" x2="0" y2="0" width="0" layer="20"/>
</plain>
<libraries>
<library name="test">
<packages>
<package name="R0603">
<smd name="1" x="-0.8" y="0" dx="0.9" dy="1" layer="1"/>
<smd name="2" x="0.8" y="0" dx="0.9" dy="1" layer="1"/>
</package>
<package name="HDR2">
<pad name="1" x="0" y="0" drill="1" shape="square"/>
<pad name="2" x="2.54" y="0" drill="1" shape="long"/>
</package>
<package name="MH">
<hole x="0" y="0" drill="3.2"/>
<circle x="0" y="0" radius="3" width="0" layer="42"/>
</package>
</packages>
</library>
</libraries>
<designrules name="test">
<param name="layerSetup" value="(1+2*15+16)"/>
<param name="mdWireWire" value="0.2mm"/>
<param name="mdCopperDimension" value="0.5mm"/>
<param name="rvViaOuter" value="0.25"/>
<param name="rlMinViaOuter" value="8mil"/>
<param name="rlMaxViaOuter" value="20mil"/>
<param name="rvPadTop" value="0.25"/>
<param name="rlMinPadTop" value="10mil"/>
<param name="rlMaxPadTop" value="20mil"/>
<param name="psElongationLong" value="100"/>
</designrules>
<elements>
<element name="R1" library="test" package="R0603" value="33R" x="10" y="10"/>
<element name="R2" library="test" package="R0603" value="0R" x="20" y="10" rot="MR90"/>
<element name="J1" library="test" package="HDR2" value="PWR" x="5" y="20"/>
<element name="H1" library="test" package="MH" value="" x="35" y="25"/>
</elements>
<signals>
<signal name="CLK">
<contactref element="R1" pad="2"/>
<contactref element="R2" pad="1"/>
<wire x1="10.8" y1="10" x2="18" y2="10" width="0.2" layer="1"/>
<via x="18" y="10" extent="1-16" drill="0.3"/>
<wire x1="18" y1="10" x2="20" y2="9.2" width="0.2" layer="16" curve="-30"/>
</signal>
<signal name="GND">
<contactref element="R1" pad="1"/>
<contactref element="J1" pad="2"/>
<wire x1="9.2" y1="10" x2="9.2" y2="15" width="0.3" layer="1"/>
<via x="9.2" y="15" extent="1-16" drill="0.3"/>
<polygon width="0.2" layer="16" isolate="0.3" rank="1">
<vertex x="0" y="0"/><vertex x="40" y="0"/><vertex x="40" y="30"/><vertex x="0" y="30"/>
</polygon>
<polygon width="0.2" layer="1" isolate="0.3" rank="1">
<vertex x="25" y="2"/><vertex x="30" y="2"/><vertex x="30" y="5"/><vertex x="25" y="5"/>
</polygon>
</signal>
<signal name="VCC">
<contactref element="J1" pad="1"/>
<polygon width="0.2" layer="15" isolate="0.3" rank="1">
<vertex x="0" y="0"/><vertex x="40" y="0"/><vertex x="40" y="30"/><vertex x="0" y="30"/>
</polygon>
</signal>
</signals>
</board>
</drawing>
</eagle>
